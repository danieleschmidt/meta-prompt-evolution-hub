{
  "backup_frequency": {
    "incremental": "daily",
    "full": "weekly",
    "archive": "monthly"
  },
  "retention_policy": {
    "daily_backups": 30,
    "weekly_backups": 12,
    "monthly_backups": 12,
    "yearly_backups": 7
  },
  "backup_targets": [
    "application_data",
    "database",
    "configuration",
    "logs"
  ],
  "storage_locations": [
    "primary_region_s3",
    "secondary_region_s3",
    "offsite_backup"
  ],
  "encryption": {
    "enabled": true,
    "key_management": "aws_kms",
    "algorithm": "AES-256"
  }
}
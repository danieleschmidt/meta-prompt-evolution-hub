{
  "region": "eu-west-1",
  "availability_zones": [
    "eu-west-1a",
    "eu-west-1b",
    "eu-west-1c"
  ],
  "instance_types": [
    "m5.large",
    "m5.xlarge",
    "c5.large",
    "c5.xlarge"
  ],
  "network_config": {
    "vpc_cidr": "10.1.0.0/16",
    "subnet_cidrs": [
      "10.1.1.0/24",
      "10.1.2.0/24",

{
  "region": "ap-southeast-1",
  "availability_zones": [
    "ap-southeast-1a",
    "ap-southeast-1b",
    "ap-southeast-1c"
  ],
  "instance_types": [
    "m5.large",
    "m5.xlarge",
    "c5.large",
    "c5.xlarge"
  ],
  "network_config": {
    "vpc_cidr": "10.2.0.0/16",
    "subnet_cidrs": [
      "10.2.1.0/24",
      "10.2.2.0/24",
      "10.2.3.0/24"
    ]
  },
  "storage_config": {
    "backup_region": "ap-northeast-1",
    "replication_enabled": true
  },
  "monitoring_config": {
    "prometheus_endpoint": "https://prometheus-ap-southeast-1.monitoring.example.com",
    "grafana_endpoint": "https://grafana-ap-southeast-1.monitoring.example.com"
  }
}
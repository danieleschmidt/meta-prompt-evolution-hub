{
  "region": "us-east-1",
  "availability_zones": [
    "us-east-1a",
    "us-east-1b",
    "us-east-1c"
  ],
  "instance_types": [
    "m5.large",
    "m5.xlarge",
    "c5.large",
    "c5.xlarge"
  ],
  "network_config": {
    "vpc_cidr": "10.0.0.0/16",
    "subnet_cidrs": [
      "10.0.1.0/24",
      "10.0.2.0/24",
      "10.0.3.0/24"
    ]
  },
  "storage_config": {
    "backup_region": "us-west-2",
    "replication_enabled": true
  },
  "monitoring_config": {
    "prometheus_endpoint": "https://prometheus-us-east-1.monitoring.example.com",
    "grafana_endpoint": "https://grafana-us-east-1.monitoring.example.com"
  }
}